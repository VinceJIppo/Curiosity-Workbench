{
  "name": "cto-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/rename-output.mjs",
    "test": "npm run build --silent && vitest run",
    "test:unit": "vitest run --exclude tests/built-file.test.ts",
    "typecheck": "tsc --noEmit",
    "samples": "UPDATE_SAMPLES=1 vitest run tests/samples.test.ts",
    "verify:browser": "npm run build --silent && node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "papaparse": "^5.7.1",
    "preact": "^11.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
